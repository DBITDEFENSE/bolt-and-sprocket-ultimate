extends GutTest
## Movement parity: BoltMotor (the Godot port) must reproduce the original web build's movement.
## tests/data/bolt_parity.json is generated by tools/parity/bolt_reference.mjs from the ORIGINAL formulas
## and CONFIG; this runs the same input scripts through BoltMotor on the same flat floor at 60 Hz.

const DT: float = 1.0 / 60.0
var _ref: Dictionary


func before_all() -> void:
	_ref = JSON.parse_string(FileAccess.get_file_as_string("res://tests/data/bolt_parity.json"))


func _inputs(script: Array, f: int, m: BoltMotor) -> Dictionary:
	var inp: Dictionary = {"dir": Vector3.ZERO, "jump_held": false, "sprint": false, "crouch_held": false,
		"press": false, "dash": null, "slide": null, "slam": null}
	for s0: Variant in script:
		var s: Dictionary = s0
		var active: bool = int(s["at"]) == f if s.has("at") else (f >= int(s["from"]) and f < int(s["to"]))
		if not active:
			continue
		if s.get("press", "") == "jump":
			inp["press"] = true
		if s.get("hold", "") == "jump":
			inp["jump_held"] = true
		if s.has("dir"):
			inp["dir"] = Vector3(float(s["dir"][0]), 0, float(s["dir"][1]))
		if s.get("sprint", false):
			inp["sprint"] = true
		if s.has("dash"):
			inp["dash"] = Vector3(float(s["dash"][0]), 0, float(s["dash"][1]))
		if s.has("slide"):
			inp["slide"] = Vector3(float(s["slide"][0]), 0, float(s["slide"][1]))
		if s.has("slam"):
			inp["slam"] = StringName(str(s["slam"]))
		if s.get("pressEachGroundFrame", false) and m.on_ground and m.slam_bounce_t > 0.0:
			inp["press"] = true
	return inp


## Runs one scenario; the "body" is a point on a flat floor at y = 0 (feet), like the reference.
func _run(sc: Dictionary) -> Dictionary:
	var m: BoltMotor = BoltMotor.new(Data.table("bs/tuning"))
	var pos: Vector3 = Vector3(0, m.hy, 0)
	var apex: float = 0.0
	var air: int = 0
	var left: int = -1
	var max_speed: float = 0.0
	for f: int in int(sc["frames"]):
		var inp: Dictionary = _inputs(sc["script"], f, m)
		if inp["press"]:
			m.press_jump()
		if inp["dash"] != null:
			m.press_dash(inp["dash"])
		if inp["slide"] != null:
			m.start_slide(inp["slide"])
		if inp["slam"] != null:
			m.start_slam(inp["slam"])
		pos.y += m.pending_dy
		m.pending_dy = 0.0
		var was: bool = m.on_ground
		m.pre_move(DT, inp)
		pos.y += m.pending_dy
		m.pending_dy = 0.0
		pos += m.vel * DT
		var grounded: bool = false
		if pos.y - m.hy <= 0.0:
			pos.y = m.hy
			if m.vel.y < 0.0:
				m.vel.y = 0.0
			grounded = true
		m.post_move(DT, grounded, was, pos.y)
		apex = maxf(apex, pos.y - m.hy)
		if not grounded:
			air += 1
			if left < 0:
				left = f
		max_speed = maxf(max_speed, Vector2(m.vel.x, m.vel.z).length())
	return {"apex": apex, "air_frames": air, "max_speed": max_speed, "end": [pos.x, pos.y - m.hy, pos.z]}


func _check(id: String) -> void:
	var sc: Dictionary = _ref["scenarios"][id]
	var want: Dictionary = sc["expect"]
	var got: Dictionary = _run(sc)
	assert_almost_eq(float(got["apex"]), float(want["apex"]), 0.02, "%s apex" % id)
	assert_almost_eq(float(got["air_frames"]), float(want["air_frames"]), 1.0, "%s airtime (frames)" % id)
	assert_almost_eq(float(got["max_speed"]), float(want["max_speed"]), 0.02, "%s top speed" % id)
	for i: int in 3:
		assert_almost_eq(float(got["end"][i]), float(want["end"][i]), 0.03, "%s end position axis %d" % [id, i])


func test_jump_full() -> void: _check("jump_full")
func test_jump_tap() -> void: _check("jump_tap")
func test_double_jump() -> void: _check("double_jump")
func test_hover() -> void: _check("hover")
func test_walk_accel() -> void: _check("walk_accel")
func test_sprint_accel() -> void: _check("sprint_accel")
func test_dash_ground() -> void: _check("dash_ground")
func test_dash_jump() -> void: _check("dash_jump")
func test_slide() -> void: _check("slide")
func test_long_jump() -> void: _check("long_jump")
func test_slam() -> void: _check("slam")
func test_slam_bounce() -> void: _check("slam_bounce")
func test_sprint_jump() -> void: _check("sprint_jump")
