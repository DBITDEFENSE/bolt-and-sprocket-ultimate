; Engine configuration file.
; TERMS & CONDITIONS — Godot 4.7.x stable, Forward+. See docs/DECISIONS.md.

config_version=5

[application]

config/name="TERMS & CONDITIONS"
; T-264: the macOS export writes the name into Info.plist unescaped: the "&" made the plist invalid XML (an app that
; cannot start). On macOS the app, its window and its user folder are named like the Windows product.
config/name.macos="CLAUDE ZOMBIES"
config/description="Bolt & Sprocket (remade) + GRAVELIGHT + THE FINE PRINT."
config/version="0.0.1-m0"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[autoload]

Game="*res://core/game.gd"
EventBus="*res://core/event_bus.gd"
Data="*res://core/data.gd"
Settings="*res://core/settings.gd"
SaveProfile="*res://core/save_profile.gd"
VOManager="*res://core/vo_manager.gd"
BS="*res://bs/bs_state.gd"
AimAssist="*res://core/aim_assist.gd"
GLBus="*res://gravelight/autoload/event_bus.gd"
GLData="*res://gravelight/autoload/data.gd"
GLSettings="*res://gravelight/autoload/settings.gd"
ProfileSave="*res://gravelight/autoload/profile_save.gd"
GameState="*res://gravelight/autoload/game_state.gd"
Economy="*res://gravelight/autoload/economy.gd"
RoundManager="*res://gravelight/autoload/round_manager.gd"
PowerupManager="*res://gravelight/autoload/powerup_manager.gd"
PerkManager="*res://gravelight/autoload/perk_manager.gd"
CrateManager="*res://gravelight/autoload/crate_manager.gd"
QuestManager="*res://gravelight/autoload/quest_manager.gd"
AudioDirector="*res://gravelight/autoload/audio_director.gd"
GLVO="*res://gravelight/autoload/vo_manager.gd"
Effects="*res://gravelight/autoload/effects.gd"
Net="*res://gravelight/autoload/net.gd"
Lobbies="*res://gravelight/net/lobby_service.gd"
MapPacks="*res://gravelight/autoload/map_packs.gd"
GLConsole="*res://gravelight/ui/dev_console.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

common/max_physics_steps_per_frame=4
; T-283 (docs/perf/t281_zombie_count_2026-11.md, "Phase 2"): Jolt instead of Godot Physics. Map 0 at 24 / 48 zombies:
; the game thread's frame -20 % / -19 %, the 1 % worst nearly halved; full GUT suite and the movement / physics smokes
; pass. Back to Godot Physics: 3d/physics_engine="GodotPhysics3D" (or the same line in an override.cfg beside this file).
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
; T-264 (macOS / SteamOS), docs/u21/t264_ports.md. Keep these lines together (the ports' own block).
; Apple silicon reads ETC2 / ASTC textures: the universal macOS export refuses to run without this import. Windows and
; Linux builds still ship S3TC / BPTC only (their presets' texture_format options).
textures/vram_compression/import_etc2_astc=true
; The renderer on its own thread (what Play.bat's --render-thread separate does, T-258) for any export preset that
; carries the custom feature "cz_render_thread". No preset carries it today: the Linux build hung when quitting
; after a match with it (Vulkan, software GPU). Any build can try it with the launch option --render-thread separate.
driver/threads/thread_model.cz_render_thread=2

[audio]

general/text_to_speech=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gl_web_export/plugin.cfg")

[layer_names]


3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombie_body"
3d_physics/layer_4="zombie_hitbox"
3d_physics/layer_5="interactable"
3d_physics/layer_6="barricade"
3d_physics/layer_7="projectile"
3d_physics/layer_8="pickup"
3d_physics/layer_9="door"
3d_physics/layer_10="decor"

[debug]

file_logging/max_log_files=30

[shader_globals]

gl_daylight={
"type": "float",
"value": 0.0
}
gl_day_sky={
"type": "color",
"value": Color(0.5, 0.56, 0.64, 1)
}
