    "_doc": "New player-facing lines owned by the weapons builder (VOManager's index doesn't carry them yet; WeaponText falls back to these).",
    "bs.weapon.levelup.01": {"who": "sprocket", "text": "Your gun leveled up. It's growing. I'm not crying, you're crying."},
    "bs.weapon.levelup.02": {"who": "sprocket", "text": "V3! It's learned a trick. I'd say it was me who taught it, but it wasn't."},
    "bs.weapon.levelup.03": {"who": "sprocket", "text": "V5. That thing has seen more combat than most generals. Blartz will want to touch it."},
    "bs.weapon.levelup.04": {"who": "sprocket", "text": "Level up. The weapon is improving. The wielder remains a work in progress."},
    "bs.weapon.zap.amp.01": {"who": "sprocket", "text": "Oh, so I'm a PYLON now. Great. Really living the dream."},
    "bs.weapon.zap.amp.02": {"who": "sprocket", "text": "Standing still in a firefight. This is a choice. This is YOUR choice."},
    "bs.weapon.zap.amp.03": {"who": "sprocket", "text": "My capacitors are filing a grievance. With me. About you."},
    "bs.weapon.zap.amp.04": {"who": "sprocket", "text": "Fine! FINE! UNLIMITED POWER! Or, you know, about twelve volts more than usual."},
    "bs.weapon.zap.amp.05": {"who": "sprocket", "text": "Can I move now? I'm moving. I'm moving now."},
    "bs.weapon.hint.heat": {"who": "hint", "text": "OVERHEAT! Let the Omni-Blaster vent, or cash the heat in with a HOT ROUND (alt-fire)."},
    "bs.weapon.hint.hot_round_cold": {"who": "hint", "text": "Hot Round needs at least 25 heat. Spray first, then cash it in."},
    "bs.weapon.hint.rift_cd": {"who": "hint", "text": "The Rift is still stitching itself shut."},
