  "lines": {
    "bs.boss.repotron.intro.01": {
      "who": "glambot",
      "text": "LIVE from the Scrapheap, it's REPOSSESSION OF THE WEEK! In the compactor corner — eleven tonnes of PAST DUE — it's REPO-TROOOON!"
    },
    "bs.boss.repotron.intro.02": {
      "who": "sprocket",
      "text": "He's reading off cue cards. You can see them. OmniScrap is paying him by the exclamation point."
    },
    "bs.boss.repotron.steal.01": {
      "who": "pa",
      "text": "ITEM REPOSSESSED. YOU MAY REPURCHASE IT AT A REASONABLE MARKUP."
    },
    "bs.boss.repotron.steal.02": {
      "who": "bolt",
      "text": "Hey! I was USING that!"
    },
    "bs.boss.repotron.steal.03": {
      "who": "sprocket",
      "text": "The hook, Bolt. Smash the hook. It's literally hanging your stuff in front of you."
    },
    "bs.boss.repotron.compact.01": {
      "who": "pa",
      "text": "COMPACTION IN PROGRESS. PLEASE REMAIN FLAT."
    },
    "bs.boss.repotron.compact.02": {
      "who": "sprocket",
      "text": "The walls are moving. I'd like to file a complaint with the walls."
    },
    "bs.boss.repotron.compact.03": {
      "who": "pa",
      "text": "PROCESSING ERROR. ASSET HAS RESISTED COMPACTION."
    },
    "bs.boss.repotron.banner.compaction.01": {
      "who": "banner",
      "text": "COMPACTION"
    },
    "bs.boss.repotron.banner.compaction.02": {
      "who": "banner",
      "text": "The walls are closing in. Hit the PAST DUE stamp after a slam to push them back."
    },
    "bs.boss.sentinel.intro.01": {
      "who": "glambot",
      "text": "Pool-deck security, darlings! It checks wristbands, it checks IDs, it checks your PULSE — the RUSTVANE SENTINELLL!"
    },
    "bs.boss.sentinel.intro.02": {
      "who": "bolt",
      "text": "Do we have wristbands?"
    },
    "bs.boss.sentinel.intro.03": {
      "who": "sprocket",
      "text": "We have a mallet. It's like a wristband, but for its face."
    },
    "bs.boss.sentinel.bark.01": {
      "who": "pa",
      "text": "GUEST, YOU ARE IN A STAFF-ONLY QUARRY. PLEASE RETURN TO THE FUN."
    },
    "bs.boss.sentinel.bark.02": {
      "who": "pa",
      "text": "LOCKDOWN. THE RESORT IS NOW CLOSED FOR YOUR SAFETY. YOUR SAFETY IS NOW CLOSED."
    },
    "bs.boss.sentinel.bark.03": {
      "who": "sprocket",
      "text": "It's got a searchlight. Of course it does. Everything on this planet wants to be looked at."
    },
    "bs.boss.sentinel.bark.04": {
      "who": "pa",
      "text": "RESORT POLICY: NO RUNNING. NO SWIMMING. NO SURVIVING."
    },
    "bs.boss.sentinel.bark.05": {
      "who": "sprocket",
      "text": "Security's down. The Content Creator's pool deck is open. I hope it doesn't want to collab."
    },
    "bs.boss.sentinel.banner.lockdown.01": {
      "who": "banner",
      "text": "LOCKDOWN"
    },
    "bs.boss.sentinel.banner.lockdown.02": {
      "who": "banner",
      "text": "Armor off. Twin beams. Stay out of the searchlight."
    },
    "bs.boss.sentinel.banner.policy.01": {
      "who": "banner",
      "text": "RESORT POLICY"
    },
    "bs.boss.sentinel.banner.policy.02": {
      "who": "banner",
      "text": "Treads engaged. Make it ram a pillar."
    },
    "bs.boss.sentinel.banner.defeat.01": {
      "who": "banner",
      "text": "SECURITY BREACHED"
    },
    "bs.boss.sentinel.banner.defeat.02": {
      "who": "banner",
      "text": "Wristbands are now optional"
    },
    "bs.boss.sentinel.hint.spotted.01": {
      "who": "hint",
      "text": "SPOTTED — the next mortars are coming for YOU. Keep moving!"
    },
    "bs.boss.cc.unbox.01": {
      "who": "cc",
      "text": "Okay chat, what's in the box?! Smash that like if you think it's DANGER!"
    },
    "bs.boss.cc.unbox.02": {
      "who": "cc",
      "text": "Oh my GOD it's a bomb. This is SO sponsored."
    },
    "bs.boss.cc.collab.01": {
      "who": "cc",
      "text": "Collab time! Say hi to my co-host, who is also me, but with better lighting!"
    },
    "bs.boss.cc.collab.02": {
      "who": "sprocket",
      "text": "It collabed with a hologram of itself. That's the most honest thing it's done."
    },
    "bs.boss.cc.live.01": {
      "who": "cc",
      "text": "We are LIVE, scrap-fam! Chat, do your thing!"
    },
    "bs.boss.cc.live.02": {
      "who": "cc",
      "text": "Chat says \"boil the pool.\" Chat is never wrong."
    },
    "bs.boss.cc.drones.01": {
      "who": "cc",
      "text": "My CREW! Who's filming me?! If nobody's filming me, do I even EXIST?!"
    },
    "bs.boss.cc.drones.02": {
      "who": "sprocket",
      "text": "No cameras, no shield. It's like a vampire, but for engagement."
    },
    "bs.boss.cc.banner.demonetized.02": {
      "who": "banner",
      "text": "The Content Creator sheds its armor!"
    },
    "bs.boss.cc.banner.collab.01": {
      "who": "banner",
      "text": "COLLAB"
    },
    "bs.boss.cc.banner.collab.02": {
      "who": "banner",
      "text": "A very special guest. Who is also the Content Creator."
    },
    "bs.boss.cc.banner.live.01": {
      "who": "banner",
      "text": "GOING LIVE"
    },
    "bs.boss.cc.banner.live.02": {
      "who": "banner",
      "text": "Chat has taken over. Stay on the dark tiles."
    },
    "bs.boss.cc.banner.defeat.01": {
      "who": "banner",
      "text": "UNSUBSCRIBED"
    },
    "bs.boss.cc.banner.defeat.02": {
      "who": "banner",
      "text": "The stream has ended"
    },
    "bs.boss.cc.hint.chat.01": {
      "who": "hint",
      "text": "Chat is typing... Get out of the glowing lanes!"
    },
    "bs.boss.algorithm.feed.01": {
      "who": "pa",
      "text": "RECOMMENDED FOR YOU: MORE OF THIS."
    },
    "bs.boss.algorithm.feed.02": {
      "who": "pa",
      "text": "BASED ON YOUR INTERESTS: PAIN."
    },
    "bs.boss.algorithm.feed.03": {
      "who": "pa",
      "text": "YOU MAY ALSO LIKE: A FINE."
    },
    "bs.boss.algorithm.overload.01": {
      "who": "sprocket",
      "text": "Feed it paperwork! It can't process legal documents. Nothing can!"
    },
    "bs.boss.algorithm.overload.02": {
      "who": "pa",
      "text": "ERROR: CONTENT POLICY VIOLATES CONTENT POLICY."
    },
    "bs.boss.algorithm.viral.01": {
      "who": "pa",
      "text": "YOU HAVE REACHED THE END OF THE FEED. GENERATING MORE FEED."
    },
    "bs.boss.algorithm.viral.02": {
      "who": "sprocket",
      "text": "The floor is a timeline now. Don't look at it too long, you'll start agreeing with it."
    },
    "bs.boss.algorithm.card.01": {
      "who": "ui",
      "text": "Because you killed a Meter Maid..."
    },
    "bs.boss.algorithm.card.02": {
      "who": "ui",
      "text": "Because you dented an HOA Enforcer..."
    },
    "bs.boss.algorithm.card.03": {
      "who": "ui",
      "text": "Trending in your area: enforcement"
    },
    "bs.boss.algorithm.banner.viral.01": {
      "who": "banner",
      "text": "VIRAL"
    },
    "bs.boss.algorithm.banner.viral.02": {
      "who": "banner",
      "text": "The feed is scrolling. Get up on a platform!"
    },
    "bs.boss.algorithm.banner.defeat.01": {
      "who": "banner",
      "text": "SHADOWBANNED"
    },
    "bs.boss.algorithm.banner.defeat.02": {
      "who": "banner",
      "text": "The Algorithm has stopped recommending things"
    },
    "bs.boss.algorithm.hint.mega.01": {
      "who": "hint",
      "text": "MEGA-FINE incoming — get onto a platform!"
    },
    "bs.boss.compost.leak.01": {
      "who": "sprocket",
      "text": "Those pipes are poisoning him. He's not attacking us — he's in PAIN. Seal the leaks!"
    },
    "bs.boss.compost.leak.02": {
      "who": "corn",
      "text": "...That. Felt. Better."
    },
    "bs.boss.compost.leak.03": {
      "who": "corn",
      "text": "NO! The pipes! THE PIPES!"
    },
    "bs.boss.compost.mercy.01": {
      "who": "sprocket",
      "text": "Bolt. Put the mallet down. He just wants the leaking to stop."
    },
    "bs.boss.compost.mercy.02": {
      "who": "corn",
      "text": "You... sealed it. All of it. Nobody has ever sealed it."
    },
    "bs.boss.compost.mercy.03": {
      "who": "corn",
      "text": "Take the core. Take it! And tell the harvester's owners the swamp sends its regards. Rudely."
    },
    "bs.boss.compost.mercy.04": {
      "who": "bolt",
      "text": "Best negotiation I've ever been in. Also the only one."
    },
    "bs.boss.compost.enrage.01": {
      "who": "corn",
      "text": "You talk peace with the pipes still OPEN?!"
    },
    "bs.boss.compost.defeat.01": {
      "who": "corn",
      "text": "The rot... settles. Tell the corn I was never a monster. Tell them I was a COMMUNITY."
    },
    "bs.boss.compost.banner.thrash.01": {
      "who": "banner",
      "text": "THRASHING"
    },
    "bs.boss.compost.banner.thrash.02": {
      "who": "banner",
      "text": "The leaks burst. Seal them while he swings."
    },
    "bs.boss.compost.banner.talk": {
      "who": "banner",
      "text": "let's talk!"
    },
    "bs.boss.compost.banner.mercy.01": {
      "who": "banner",
      "text": "COLLECTIVE BARGAINING"
    },
    "bs.boss.compost.banner.mercy.02": {
      "who": "banner",
      "text": "He stands down. The swamp calms."
    },
    "bs.boss.compost.banner.defeat.01": {
      "who": "banner",
      "text": "COMPOSTED"
    },
    "bs.boss.compost.banner.defeat.02": {
      "who": "banner",
      "text": "The outfall drains. Something glows at the centre."
    }
  },
