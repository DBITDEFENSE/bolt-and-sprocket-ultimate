    "__src__": "() => { if (ZE_MODE === 'race') openRace(); else if (ZE_MODE === 'loopriot') LR.open(); else if (ZE_MODE === 'arena') openArena(); else openZongaLobby(); }"
  },
  "loopriot": {
    "__fn__": "loopriot",
    "__src__": "() => LR.back()"
  },
  "arena": {
    "__fn__": "arena",
    "__src__": "() => showMenu()"
  },
  "race": {
    "__fn__": "race",
    "__src__": "() => showMenu()"
  },
  "questLog": {
    "__fn__": "questLog",
    "__src__": "() => { G.state = 'paused'; setScreen('pause'); }"
  },
  "memoLog": {
    "__fn__": "memoLog",
    "__src__": "() => { if (MEMO_FROM === 'extras') { G.state = 'extras'; setScreen('extras'); } else { G.state = 'paused'; setScreen('pause'); } }"
  },
  "extras": {
    "__fn__": "extras",
    "__src__": "() => showMenu()"
  },
  "gallery": {
