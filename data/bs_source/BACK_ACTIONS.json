    "__src__": "() => { G.state = 'extras'; setScreen('extras'); }"
  },
  "credits": {
    "__fn__": "credits",
    "__src__": "() => { G.state = 'extras'; setScreen('extras'); }"
  },
  "settings": {
    "__fn__": "settings",
    "__src__": "() => closeSettings()"
  },
  "starmap": {
    "__fn__": "starmap",
    "__src__": "() => { if (SM.from === 'level') returnToPlay(); else showMenu(); }"
  },
  "shop": {
