# UPDATE 05 asset intake (T-087): Devin's drop folder and raw downloads never enter git; the imports of third-party
# assets do (their .import files carry the import presets, so a fresh clone imports them the same way).
assets/user_supplied/
tools_src/_downloads/
!assets/third_party/**/*.import
# our own models (T-089 arms, T-094 world objects): same reason
!assets/ours/**/*.import

# per-machine tool paths (tools/env.sh); written by tools/cloud_setup.sh on Linux
tools/local_paths.env
/tools/dl_blender/

# UPDATE 06 Part B voice acting (T-101): raw recordings and consent notes are personal data: never committed or
# pushed (only voice_inbox/README.txt and its .gdignore are). The importer's working folder (normalized audio,
# transcripts, take previews) and the generated review page (it plays those private takes) stay local too.
voice_inbox/*
!voice_inbox/README.txt
!voice_inbox/.gdignore
voice_work/
voice_review/

# UPDATE 09 (T-139): export output (tools/build_web.sh, tools/build_windows.sh)
/build/
# Local secrets written by `elevenlabs onboard`
/.env.local
# UPDATE 11 (T-193): the ElevenLabs take cache (raw API audio by hash, shared by every worktree; never committed)
.voice_cache/
